# ============================================================
# Whisky Data JP  SNS集客bot  設定
# コピーして .env にリネームし、値を埋めること。
# .env はリポジトリにコミットしない（.gitignore に含まれる）。
# ============================================================

# ---- サイト ----
BOT_SITE_URL=https://whisky-data.jp
BOT_CONTENT_DIR=site/src/content
BOT_OGP_DIR=site/public/ogp

# ---- 投稿制御 ----
# true の間は実際に投稿せず、生成文と投稿先を表示するだけ（推奨）。
BOT_DRY_RUN=true
# 1日あたりの投稿上限（1SNSごと）
BOT_DAILY_LIMIT=2
# 投稿に付ける基本ハッシュタグ（スペース区切り）
BOT_HASHTAGS="#ウイスキー #Whisky"

# ---- X（Twitter）API v2 ----
# 必須: Write権限を有効にしたTwitter DeveloperアプリのBearerトークン。
X_API_BEARER_TOKEN=
# 画像添付を行う場合のみ必要（OAuth1.0a user context）。
X_API_ACCESS_TOKEN=
X_API_ACCESS_SECRET=

# ---- Threads API（任意・Phase 3）----
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ---- LLM生成（任意・Phase 4）----
# OpenAI互換エンドポイント。未設定ならテンプレート生成にフォールバック。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
