# ============================================================
# Whisky Data JP  SNS集客bot  設定
# コピーして .env にリネームし、値を埋めること。
# .env はリポジトリにコミットしない（.gitignore に含まれる）。
# ============================================================

# ---- サイト ----
BOT_SITE_URL=https://whisky-data.jp
BOT_CONTENT_DIR=site/src/content
BOT_OGP_DIR=site/public/ogp

# ---- 投稿制御 ----
# true の間は実際に投稿せず、生成文と投稿先を表示するだけ（推奨）。
BOT_DRY_RUN=true
# 1日あたりの投稿上限（1SNSごと）
BOT_DAILY_LIMIT=2
# 投稿に付ける基本ハッシュタグ（スペース区切り）
BOT_HASHTAGS="#ウイスキー #Whisky"

# ---- X (dekio_g) / Threads (devil_dog_ch) の認証情報 ----
# トークンは環境変数ではなく GitHub Gist で管理する（src/gistState.mjs / threadsAuth.mjs）。
# 理由:
#   - Threads の長期トークンは約60日で失効し、リフレッシュが要る
#   - GitHub Actions のランナーは実行のたびに使い捨てなので、リフレッシュ後の
#     トークンをどこかに永続化しないと次回また古いトークンで失敗する
#   - 公開リポジトリの git 履歴や Actions Secrets の平文にトークンを残したくない
#
# ローカルで試す場合:
#   - GH_GIST_TOKEN / GIST_ID を設定して本物の Gist を読み書きするか、
#   - LOCAL_STATE_FILE=./09-sns-bot/.local-state.json のようにローカルファイルで代替する
#     （形式は gistState.mjs 経由で読み書きする JSON。中身は下記参照。このファイルもコミットしないこと）
#
# Gist / ローカルファイルの中身:
# {
#   "accounts": {
#     "dekio_g":      { "platform": "x", "oauth_version": "oauth1",
#                        "consumer_key": "...", "consumer_secret": "...",
#                        "access_token": "...", "access_token_secret": "..." },
#     "devil_dog_ch": { "platform": "threads", "user_id": "...", "token": "...",
#                        "expires_at": "2026-08-10T04:33:35.332Z" }
#   },
#   "history": { "records": [] }
# }
GH_GIST_TOKEN=
GIST_ID=
# LOCAL_STATE_FILE=

# ---- LLM生成（任意・Phase 4）----
# OpenAI互換エンドポイント。未設定ならテンプレート生成にフォールバック。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
