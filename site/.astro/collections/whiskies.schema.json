{
  "$ref": "#/definitions/whiskies",
  "definitions": {
    "whiskies": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "nameEn": {
          "type": "string"
        },
        "distillery": {
          "type": "string"
        },
        "distillerySlug": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "enum": [
            "scotland",
            "japan",
            "usa",
            "ireland",
            "taiwan",
            "india",
            "australia"
          ]
        },
        "region": {
          "type": "string",
          "enum": [
            "islay",
            "speyside",
            "highland",
            "lowland",
            "campbeltown",
            "island",
            "japan",
            "kentucky",
            "tennessee",
            "ireland",
            "taiwan",
            "india",
            "australia"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "single-malt",
            "blended",
            "blended-malt",
            "grain",
            "bourbon",
            "tennessee",
            "rye"
          ]
        },
        "age": {
          "type": "number"
        },
        "abv": {
          "type": "number"
        },
        "cask": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "priceYen": {
          "type": "number"
        },
        "priceAsOf": {
          "type": "string"
        },
        "priceSource": {
          "type": "string",
          "enum": [
            "market",
            "editorial"
          ],
          "default": "editorial"
        },
        "availability": {
          "type": "string",
          "enum": [
            "common",
            "limited",
            "rare"
          ],
          "default": "common"
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "flavor": {
          "type": "object",
          "properties": {
            "peat": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "sweet": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "fruity": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "spicy": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "oak": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "smoky": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "complex": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "body": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "required": [
            "peat",
            "sweet",
            "fruity",
            "spicy",
            "oak",
            "smoky",
            "complex",
            "body"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string"
        },
        "recommendedFor": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "affiliateId": {
          "type": "string"
        },
        "whiskybase": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "votes": {
              "type": "number"
            },
            "checkedAt": {
              "type": "string"
            }
          },
          "required": [
            "score",
            "votes",
            "checkedAt"
          ],
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "nameEn",
        "distillery",
        "country",
        "region",
        "type",
        "abv",
        "rating",
        "flavor",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}