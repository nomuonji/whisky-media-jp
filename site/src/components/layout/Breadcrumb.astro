---
import type { BreadcrumbItem } from '../../types/navigation';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="パンくずリスト">
  <ol class="breadcrumb-list">
    {items.map((item, i) => (
      <li>
        {i > 0 ? <span class="breadcrumb-separator" aria-hidden="true">/</span> : null}
        {i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span class="breadcrumb-current" aria-current="page" title={item.label}>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
