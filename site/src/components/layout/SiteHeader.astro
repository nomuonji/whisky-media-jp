---
import { SITE } from '../../data/site';
import { MAIN_NAV } from '../../data/navigation';
import MainNav from './MainNav.astro';
import Container from './Container.astro';
import Icon from '../ui/Icon.astro';

// サイト名は data/site.ts が単一の情報源。先頭の1語だけをブランドカラーで強調する
const [firstWord, ...restWords] = SITE.name.split(' ');
---

<header class="site-header">
  <Container>
    <a href="/" class="site-title" aria-label={`${SITE.name} トップページ`}>
      <Icon name="glass" size={22} class="site-title-mark" />
      <span class="accent">{firstWord}</span>{restWords.length ? ` ${restWords.join(' ')}` : ''}
    </a>
    <MainNav items={MAIN_NAV} />
    <a href="/search/" class="site-search-link" aria-label="サイト内を検索">
      <Icon name="search" size={18} />
      <span>検索</span>
    </a>
  </Container>
</header>
