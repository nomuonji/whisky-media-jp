---
import ListLayout from '../../layouts/ListLayout.astro';
import PostList from '../../components/blog/PostList.astro';
import { getPublishedPosts } from '../../utils/posts';
import { articlesUrl } from '../../utils/url';
import { totalPages } from '../../utils/pagination';

const posts = await getPublishedPosts();
const hasNext = totalPages(posts.length) > 1;
---

<ListLayout
  title="記事一覧"
  description="ウイスキーの比較・ランキング・初心者ガイドなど、データをもとにした記事の一覧です。"
  heading="記事"
  headingAccent="一覧"
  lead="銘柄データをもとにした比較・ガイド・ニュースをまとめています。"
  breadcrumbs={[
    { label: 'ホーム', href: '/' },
    { label: '記事一覧', href: '/articles/' },
  ]}
  nextUrl={hasNext ? articlesUrl(2) : undefined}
>
  <PostList {posts} page={1} hrefFor={articlesUrl} />
</ListLayout>
