---
import ListLayout from '../../layouts/ListLayout.astro';
import PostList from '../../components/blog/PostList.astro';
import { categoryLabel, categoryDescription } from '../../data/categories';
import { getPublishedPosts, byCategory } from '../../utils/posts';
import { categoryUrl } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map((p) => p.data.category))];

  return categories.map((cat) => ({
    params: { cat },
    props: { posts: byCategory(posts, cat) },
  }));
}

const { cat } = Astro.params;
const { posts } = Astro.props;

const label = categoryLabel(cat!);
const description = categoryDescription(cat!);
---

<ListLayout
  title={`${label}の記事一覧`}
  description={`${label}カテゴリのウイスキー記事一覧。${description}`}
  heading="カテゴリ"
  headingAccent={label}
  lead={description}
  breadcrumbs={[
    { label: 'ホーム', href: '/' },
    { label, href: categoryUrl(cat!) },
  ]}
>
  <PostList {posts} />
</ListLayout>
