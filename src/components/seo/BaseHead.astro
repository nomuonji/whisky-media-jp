---
import { SITE } from '../../data/site';
import { absoluteUrl } from '../../utils/url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  /** 検索結果に載せないページ（404・検索結果など） */
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** ページネーション用の rel=prev / rel=next */
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description,
  ogImage,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  prevUrl,
  nextUrl,
} = Astro.props;

const fullTitle = `${title} | ${SITE.name}`;
const imageUrl = absoluteUrl(ogImage || SITE.ogImage);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : null}
{prevUrl ? <link rel="prev" href={absoluteUrl(prevUrl)} /> : null}
{nextUrl ? <link rel="next" href={absoluteUrl(nextUrl)} /> : null}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:image" content={imageUrl} />
{type === 'article' && publishedTime ? (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
) : null}
{type === 'article' && modifiedTime ? (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
) : null}

<meta name="twitter:card" content="summary_large_image" />
{SITE.twitter ? <meta name="twitter:site" content={SITE.twitter} /> : null}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700&family=Noto+Serif+JP:wght@700&display=swap" rel="stylesheet" />
