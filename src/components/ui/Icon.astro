---
/**
 * UIアイコン。絵文字はOSごとに字形も色も変わり、サイズと位置が揃わないため使わない。
 * 20pxグリッド・線幅1.75で統一したセットをここに集約する。
 */
interface Props {
  name: 'glass' | 'cart' | 'bulb' | 'search' | 'arrow-left' | 'arrow-right';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---

<svg
  class={`icon icon-${name} ${className}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'glass' && (
    <>
      <path d="M4.5 4h11l-1 8.5a2 2 0 0 1-2 1.8h-5a2 2 0 0 1-2-1.8L4.5 4Z" />
      <path d="M5.3 9h9.4" stroke-width="1.25" />
      <path d="M7 17h6" />
    </>
  )}
  {name === 'cart' && (
    <>
      <path d="M3 4h2l1.6 8.2a1.5 1.5 0 0 0 1.5 1.2h6.3a1.5 1.5 0 0 0 1.5-1.2L17 7H6" />
      <circle cx="8.5" cy="16.5" r="1.1" />
      <circle cx="14.5" cy="16.5" r="1.1" />
    </>
  )}
  {name === 'bulb' && (
    <>
      <path d="M7.5 13a5 5 0 1 1 5 0v1.5h-5V13Z" />
      <path d="M8.5 17h3" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="8.5" cy="8.5" r="5.5" />
      <path d="M12.8 12.8 18 18" />
    </>
  )}
  {name === 'arrow-left' && <path d="M15 10H5m0 0 4-4m-4 4 4 4" />}
  {name === 'arrow-right' && <path d="M5 10h10m0 0-4-4m4 4-4 4" />}
</svg>
