---
import { getCollection } from 'astro:content';
import { REGION_LABELS, COUNTRY_LABELS, TYPE_LABELS } from '../../types/taxonomy';
import { ageLabel, priceLabel, type Whisky } from '../../utils/whisky';
import { hasSourcedPrice } from '../../utils/trust';

interface Props {
  whisky: Whisky;
}

type SourceKind = 'official' | 'market' | 'catalog';

const { whisky } = Astro.props;
const w = whisky.data;
const coreSource: SourceKind = w.officialSourceUrl ? 'official' : 'catalog';

const distilleries = await getCollection('distilleries');
const distilleryHref =
  w.distillerySlug && distilleries.some((d) => d.id === w.distillerySlug)
    ? `/distillery/${w.distillerySlug}/`
    : undefined;

const priceConditions = [
  w.priceCapacityMl ? `${w.priceCapacityMl}ml` : undefined,
  w.priceTax,
].filter(Boolean).join('・');
const priceValue = w.priceYen
  ? `${priceLabel(w.priceYen)}${priceConditions ? `（${priceConditions}）` : ''}${w.priceAsOf ? `・${w.priceAsOf}確認` : ''}`
  : '—';
const priceRowLabel = w.priceSource === 'official' && w.priceBasis ? w.priceBasis : '確認済み価格';

const rows: { label: string; value: string; href?: string; src: SourceKind }[] = [
  { label: '蒸留所', value: w.distillery, href: distilleryHref, src: coreSource },
  { label: '国・地域', value: `${COUNTRY_LABELS[w.country]}／${REGION_LABELS[w.region]}`, src: coreSource },
  { label: 'タイプ', value: TYPE_LABELS[w.type], src: coreSource },
  { label: '熟成年数', value: ageLabel(w.age), src: coreSource },
  { label: 'アルコール度数', value: `${w.abv}%`, src: coreSource },
  { label: '樽', value: w.cask.join('・') || '—', src: coreSource },
  ...(hasSourcedPrice(whisky)
    ? [{
        label: priceRowLabel,
        value: priceValue,
        href: w.priceSourceUrl,
        src: w.priceSource === 'official' ? 'official' as const : 'market' as const,
      }]
    : []),
  ...(w.officialSourceUrl
    ? [{ label: '公式商品情報', value: 'メーカー・公式ページ', href: w.officialSourceUrl, src: 'official' as const }]
    : []),
  ...(w.whiskybase
    ? [{
        label: 'Whiskybase',
        value: `${w.whiskybase.score}点（${w.whiskybase.votes}件・${w.whiskybase.checkedAt}確認）`,
        src: 'market' as const,
      }]
    : []),
];

const SRC_MARK: Record<SourceKind, string> = { official: '公', market: '外', catalog: '登' };
const SRC_TITLE: Record<SourceKind, string> = {
  official: 'メーカー・公的機関などの一次情報を確認',
  market: '出典と確認日時を持つ外部データ',
  catalog: '出典整備前のカタログ登録値',
};
---

<table class="spec-table">
  <caption class="sr-only">{w.name}の基本情報</caption>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row">{row.label}</th>
        <td>
          {row.href ? <a href={row.href} rel={row.href.startsWith('http') ? 'nofollow' : undefined}>{row.value}</a> : row.value}
          <abbr class={`src-mark src-${row.src}`} title={SRC_TITLE[row.src]}>{SRC_MARK[row.src]}</abbr>
        </td>
      </tr>
    ))}
  </tbody>
</table>
