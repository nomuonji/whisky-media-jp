---
import type { CollectionEntry } from 'astro:content';
import BottleMark from './BottleMark.astro';
import { REGION_LABELS, TYPE_LABELS } from '../../types/taxonomy';
import { whiskyUrl, ageLabel, priceLabel, type Whisky } from '../../utils/whisky';
import { getWhiskyPhoto } from '../../utils/photos';
import { hasSourcedPrice, sourceStatusLabel } from '../../utils/trust';

interface Props {
  whisky: Whisky;
  headingLevel?: 2 | 3;
  rank?: number;
  showCospa?: boolean;
}

const { whisky, headingLevel = 3, rank } = Astro.props;
const w = whisky.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const photo = getWhiskyPhoto(whisky.id);
const sourcedPrice = hasSourcedPrice(whisky);
---

<article class={`whisky-card region-${w.region}`}>
  {rank ? <span class="whisky-rank" aria-label={`${rank}位`}>{rank}</span> : null}

  <div class="whisky-card-mark">
    {photo ? (
      <img
        class="whisky-card-photo"
        src={photo.image}
        alt={`${w.name}のボトル写真`}
        loading="lazy"
        decoding="async"
        width={photo.thumbWidth ?? photo.width}
        height="auto"
      />
    ) : (
      <BottleMark region={w.region} rating={0} />
    )}
  </div>

  <div class="whisky-card-body">
    <p class="whisky-card-tags">
      <span class="badge badge-region">{REGION_LABELS[w.region]}</span>
      <span class="badge badge-neutral">{TYPE_LABELS[w.type]}</span>
      <span class="badge badge-neutral">{ageLabel(w.age)}</span>
    </p>

    <Heading class="whisky-card-title">
      <a href={whiskyUrl(whisky.id)}>{w.name}</a>
    </Heading>

    <p class="whisky-card-notes">
      {w.distillery} · {w.abv}% · <span class={`source-status ${w.officialSourceUrl || w.whiskybase ? 'is-ready' : ''}`}>{sourceStatusLabel(whisky)}</span>
    </p>
  </div>

  <div class="whisky-card-figures">
    {sourcedPrice ? <span class="whisky-price">{priceLabel(w.priceYen)}</span> : <span class="whisky-price">価格未検証</span>}
  </div>
</article>
