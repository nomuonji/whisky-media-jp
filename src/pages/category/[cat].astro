---
import ListLayout from '../../layouts/ListLayout.astro';
import PostList from '../../components/blog/PostList.astro';
import { categoryLabel, categoryDescription } from '../../data/categories';
import { getAllPublishedPosts, getPublishedPosts, byCategory } from '../../utils/posts';
import { categoryUrl } from '../../utils/url';

export async function getStaticPaths() {
  const [allPosts, activePosts] = await Promise.all([
    getAllPublishedPosts(),
    getPublishedPosts(),
  ]);
  const categories = [...new Set(allPosts.map((p) => p.data.category))];

  return categories.map((cat) => {
    const active = byCategory(activePosts, cat);
    return {
      params: { cat },
      props: {
        posts: active.length > 0 ? active : byCategory(allPosts, cat),
        archiveOnly: active.length === 0,
      },
    };
  });
}

const { cat } = Astro.params;
const { posts, archiveOnly } = Astro.props;

const label = categoryLabel(cat!);
const description = categoryDescription(cat!);
---

<ListLayout
  title={`${label}の記事一覧`}
  description={archiveOnly ? `${label}カテゴリの旧記事アーカイブ。` : `${label}カテゴリのウイスキー記事一覧。${description}`}
  heading="カテゴリ"
  headingAccent={label}
  lead={archiveOnly ? 'このカテゴリは旧評価方針の記事のみのため、URLを維持したアーカイブとして表示しています。' : description}
  noindex={archiveOnly}
  breadcrumbs={[
    { label: 'ホーム', href: '/' },
    { label, href: categoryUrl(cat!) },
  ]}
>
  {archiveOnly ? (
    <aside class="source-note is-compact">
      <p>
        <strong>旧記事アーカイブ。</strong>
        現在の検索公開方針では、出典付きの <a href="/whiskies/">銘柄データベース</a> と
        <a href="/compare/">仕様比較</a> を優先しています。
      </p>
    </aside>
  ) : null}
  <PostList {posts} />
</ListLayout>
