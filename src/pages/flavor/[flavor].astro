---
import ListLayout from '../../layouts/ListLayout.astro';
import WhiskyList from '../../components/whisky/WhiskyList.astro';
import SourceNote from '../../components/whisky/SourceNote.astro';
import DiscoveryNav from '../../components/whisky/DiscoveryNav.astro';
import { FLAVOR_FILTERS } from '../../data/discovery';

export async function getStaticPaths() {
  const { FLAVOR_FILTERS } = await import('../../data/discovery');
  const { getWhiskies, sortWhiskies } = await import('../../utils/whisky');
  const whiskies = await getWhiskies();

  return Object.entries(FLAVOR_FILTERS).map(([flavor, def]) => ({
    params: { flavor },
    props: { whiskies: sortWhiskies(whiskies.filter(def.match), def.sort) },
  }));
}

const { flavor } = Astro.params;
const { whiskies } = Astro.props;
const def = FLAVOR_FILTERS[flavor!];
---

<ListLayout
  title={`${def.label}のウイスキー${whiskies.length}銘柄`}
  description={`${def.label}のウイスキー一覧。${def.lead} ${def.criteria}`}
  heading="味"
  headingAccent={def.label}
  lead={def.lead}
  breadcrumbs={[
    { label: 'ホーム', href: '/' },
    { label: '銘柄一覧', href: '/whiskies/' },
    { label: def.label, href: `/flavor/${flavor}/` },
  ]}
>
  <aside class="source-note is-compact">
    <p>
      <strong>この一覧の抽出基準：</strong>{def.criteria}
      味の感じ方には個人差があり、公式の成分値やメーカーの格付けではありません。
    </p>
    {flavor === 'sweet' ? (
      <p>
        <strong>「甘口」と「バニラ」は別です。</strong>
        バニラは香りの表現として感じられることがあり、糖分量や舌で感じる甘味そのものを意味しません。
        甘さを選びたいときは sweet スコア、香りは各銘柄の公式ノートと編集メモを分けて確認してください。
      </p>
    ) : null}
  </aside>
  {flavor === 'sweet' ? (
    <section class="source-note" aria-labelledby="vanilla-answer-heading">
      <h2 id="vanilla-answer-heading">バニラの香りを公式ノートが挙げる例</h2>
      <p>
        「ウイスキー バニラ」で探すときは、糖分量ではなくメーカーが公表しているテイスティングノートの香り表現を見ます。
        下の2本は掲載データにあり、甘口一覧の抽出条件（編集部の sweet スコア 4/5以上）も満たします。
        公式の香り表現と、当サイトの編集メモ・ sweet スコアは別物です。感じ方には個人差があり、糖分量の測定値ではありません。
      </p>
      <ul>
        <li>
          <a href="/whisky/makers-mark/">メーカーズマーク</a>
          の公式ノートは、香りに sweet oak, vanilla, bright fruit and wheat、味わいに oak, vanilla and fruity essences と記しています
          （<a href="https://www.makersmark.com/bourbons/makers-mark" rel="nofollow">Maker's Mark 公式</a>）。
          編集部の sweet スコアは5/5で、編集メモの「バニラと蜂蜜」はこの公式文言とは別の評価です。
        </li>
        <li>
          <a href="/whisky/buffalo-trace/">バッファロートレース</a>
          の公式ノートは complex aroma of vanilla, mint and molasses とし、プロファイルにも VANILLA を挙げています
          （<a href="https://www.buffalotracedistillery.com/our-brands/buffalo-trace/buffalo-trace-bourbon" rel="nofollow">Buffalo Trace Distillery 公式</a>）。
          編集部の sweet スコアは4/5で、編集メモの「バニラとオレンジピール」は公式ノートの写しではありません。
        </li>
      </ul>
      <p>
        使い方は、バニラ香の手がかりとして公式ノートを読み、甘さの強さは sweet スコアと実飲で別々に判断することです。
        ここに挙げた表現は全員が同じように感じる保証ではありません。
      </p>
    </section>
  ) : null}
  <WhiskyList {whiskies} headingLevel={2} />
  <DiscoveryNav current={`/flavor/${flavor}/`} />
  <SourceNote />
</ListLayout>
