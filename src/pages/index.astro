---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import SourceNote from '../components/whisky/SourceNote.astro';
import BottleMark from '../components/whisky/BottleMark.astro';
import { getWhiskies, sortWhiskies, whiskyUrl, ageLabel } from '../utils/whisky';
import { isIndexReadyWhisky, sourceStatusLabel } from '../utils/trust';
import { getWhiskyPhoto } from '../utils/photos';
import { getPublishedPosts } from '../utils/posts';
import { REGION_LABELS, TYPE_LABELS, type Region } from '../types/taxonomy';
import { ja } from '../i18n/ja';

const whiskies = await getWhiskies();
const distilleries = await getCollection('distilleries');
const sourceReady = sortWhiskies(whiskies.filter(isIndexReadyWhisky), 'name');
const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);

// 見本ラベル：公式ソースと写真の両方がある銘柄を名前順で1本
const featured =
  sourceReady.find((w) => w.data.officialSourceUrl && getWhiskyPhoto(w.id)) ??
  sourceReady.find((w) => getWhiskyPhoto(w.id)) ??
  sourceReady[0];
const featuredPhoto = featured ? getWhiskyPhoto(featured.id) : undefined;
const featuredSourceHost = featured?.data.officialSourceUrl
  ? new URL(featured.data.officialSourceUrl).hostname.replace(/^www\./, '')
  : null;

// 地域ごとの登録数（多い順）
const regionCounts = Object.entries(
  whiskies.reduce<Record<string, number>>((acc, w) => {
    acc[w.data.region] = (acc[w.data.region] ?? 0) + 1;
    return acc;
  }, {}),
)
  .map(([region, count]) => ({ region: region as Region, count }))
  .sort((a, b) => b.count - a.count);

const quickLinks = [
  { label: 'ジャパニーズ', href: '/region/japan/' },
  { label: 'アイラ', href: '/region/islay/' },
  { label: 'スペイサイド', href: '/region/speyside/' },
  { label: '蒸溜所から探す', href: '/distilleries/' },
  { label: 'ウイスキーの種類を知る', href: '/2026-08-04-beginner-guide-types/' },
];
---

<BaseLayout
  title="ウイスキー銘柄データベース｜仕様・出典を比較"
  description={`Whisky Data JPはウイスキー${whiskies.length}銘柄の地域・タイプ・熟成年数・度数・樽などを日本語で整理する比較データベース。確認済みの公式・外部ソースを明示します。`}
  width="wide"
>
  <section class="home-hero">
    <div class="home-hero-text">
      <h1>{ja.site.tagline}</h1>
      <p class="home-hero-lead">
        {whiskies.length}銘柄の地域・タイプ・熟成年数・度数・樽を、同じ項目で並べています。
        どの数字がメーカー公式で、どれが未確認かも銘柄ごとに書いてあります。
      </p>

      <form class="home-search" action="/search/" method="get" role="search">
        <label for="home-q" class="sr-only">銘柄名・蒸溜所名で探す</label>
        <input id="home-q" name="q" type="search" placeholder="銘柄名・蒸溜所名（例：山崎、ラフロイグ）" autocomplete="off" />
        <button type="submit">探す</button>
      </form>

      <ul class="home-quick" aria-label="よく使う入口">
        {quickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>

      <p class="home-tally">
        <span><strong>{whiskies.length}</strong>銘柄を登録</span>
        <span><strong>{sourceReady.length}</strong>銘柄は出典確認済み</span>
        <span><strong>{distilleries.length}</strong>蒸溜所</span>
      </p>
    </div>

    {featured ? (
      <a class="spec-label" href={whiskyUrl(featured.id)} aria-label={`${featured.data.name}の仕様を見る`}>
        <div class="spec-label-head">
          <p class="spec-label-kicker">仕様の見本</p>
          <p class="spec-label-name">{featured.data.name}</p>
          <p class="spec-label-en">{featured.data.nameEn}</p>
        </div>
        <div class="spec-label-body">
          <div class="spec-label-bottle">
            {featuredPhoto ? (
              <img src={featuredPhoto.image} alt="" width="180" height="240" decoding="async" />
            ) : (
              <BottleMark region={featured.data.region} rating={0} size={90} />
            )}
          </div>
          <dl class="spec-label-rows">
            <div><dt>蒸溜所</dt><dd>{featured.data.distillery}</dd></div>
            <div><dt>地域</dt><dd>{REGION_LABELS[featured.data.region]}</dd></div>
            <div><dt>タイプ</dt><dd>{TYPE_LABELS[featured.data.type]}</dd></div>
            <div><dt>熟成</dt><dd>{ageLabel(featured.data.age)}</dd></div>
            <div><dt>度数</dt><dd>{featured.data.abv}%</dd></div>
            {featured.data.cask[0] ? <div><dt>樽</dt><dd>{featured.data.cask[0].replace(/（.*?）/g, '')}</dd></div> : null}
          </dl>
        </div>
        <p class="spec-label-source">
          <span class="spec-label-seal" aria-hidden="true">{featuredSourceHost ? '公' : '外'}</span>
          {featuredSourceHost ? `出典：メーカー公式（${featuredSourceHost}）` : sourceStatusLabel(featured)}
        </p>
        {featuredPhoto ? (
          <p class="spec-label-credit">写真：{featuredPhoto.artist} / {featuredPhoto.license}（Wikimedia Commons）</p>
        ) : null}
      </a>
    ) : null}
  </section>

  <section class="home-section" aria-labelledby="regions-heading">
    <div class="home-section-head">
      <h2 id="regions-heading">地域で探す</h2>
      <p>登録{whiskies.length}銘柄の内訳です。帯の長さが銘柄数に比例します。</p>
    </div>
    <div class="region-bar" aria-hidden="true">
      {regionCounts.map(({ region, count }) => (
        <span class={`region-${region}`} style={`flex-grow:${count}`} title={`${REGION_LABELS[region]} ${count}銘柄`}></span>
      ))}
    </div>
    <ul class="region-index">
      {regionCounts.map(({ region, count }) => (
        <li class={`region-${region}`}>
          <a href={`/region/${region}/`}>
            <span class="region-index-swatch" aria-hidden="true"></span>
            <span class="region-index-name">{REGION_LABELS[region]}</span>
            <span class="region-index-count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {sourceReady.length > 0 ? (
    <section class="home-section" aria-labelledby="ready-heading">
      <div class="home-section-head">
        <h2 id="ready-heading">出典確認済みの銘柄</h2>
        <p>メーカー等の一次情報、または確認日時つきの外部データが紐づいた銘柄。名前順で、順位ではありません。</p>
      </div>
      <ul class="bottle-shelf">
        {sourceReady.slice(0, 8).map((w) => {
          const photo = getWhiskyPhoto(w.id);
          return (
            <li class={`region-${w.data.region}`}>
              <a href={whiskyUrl(w.id)}>
                <span class="bottle-shelf-plinth">
                  {photo ? (
                    <img src={photo.image} alt="" loading="lazy" decoding="async" width="120" height="160" />
                  ) : (
                    <BottleMark region={w.data.region} rating={0} size={78} />
                  )}
                </span>
                <span class="bottle-shelf-region">{REGION_LABELS[w.data.region]}</span>
                <span class="bottle-shelf-name">{w.data.name}</span>
                <span class="bottle-shelf-spec">{ageLabel(w.data.age)}・{w.data.abv}%</span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="home-more"><a href="/whiskies/">全{whiskies.length}銘柄を条件で絞り込む</a></p>
    </section>
  ) : null}

  <section class="compare-band" aria-labelledby="compare-heading">
    <div>
      <h2 id="compare-heading">2〜4本を、同じ表に並べる</h2>
      <p>熟成年数・度数・樽・出典を横並びで見比べます。独自の点数で勝ち負けはつけません。</p>
    </div>
    <a class="compare-band-cta" href="/compare/">比較表をつくる</a>
  </section>

  {latestPosts.length > 0 ? (
    <section class="home-section" aria-labelledby="posts-heading">
      <div class="home-section-head">
        <h2 id="posts-heading">解説記事</h2>
      </div>
      <div class="post-list">
        {latestPosts.map((post) => <PostCard {post} headingLevel={3} />)}
      </div>
      <p class="home-more"><a href="/articles/">記事一覧を見る</a></p>
    </section>
  ) : null}

  <SourceNote />
</BaseLayout>
