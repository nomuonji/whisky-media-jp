---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/layout/Hero.astro';
import WhiskyList from '../components/whisky/WhiskyList.astro';
import PostCard from '../components/blog/PostCard.astro';
import SourceNote from '../components/whisky/SourceNote.astro';
import { DISCOVERY_LINKS } from '../data/navigation';
import { getWhiskies, sortWhiskies } from '../utils/whisky';
import { isIndexReadyWhisky } from '../utils/trust';
import { getPublishedPosts } from '../utils/posts';
import { ja } from '../i18n/ja';

const whiskies = await getWhiskies();
const sourceReady = sortWhiskies(whiskies.filter(isIndexReadyWhisky), 'name');
const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout
  title="ウイスキー銘柄データベース｜仕様・出典を比較"
  description={`Whisky Data JPはウイスキー${whiskies.length}銘柄の地域・タイプ・熟成年数・度数・樽などを日本語で整理する比較データベース。確認済みの公式・外部ソースを明示します。`}
  width="wide"
>
  <Hero
    title={ja.site.tagline}
    description={`ウイスキー${whiskies.length}銘柄を、地域・タイプ・熟成年数・度数・樽などの仕様で横断比較。個別ページは出典確認が済んだものから検索公開しています。`}
  />

  <nav class="discovery" aria-labelledby="discovery-heading">
    <h2 id="discovery-heading">何を調べますか？</h2>
    <ul class="discovery-links">
      {DISCOVERY_LINKS.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <p class="discovery-more">
      <a href="/whiskies/">全{whiskies.length}銘柄を絞り込む →</a>
      <a href="/compare/">2〜4本の仕様を横並びで比較 →</a>
    </p>
  </nav>

  <section class="home-section">
    <h2>データベースの公開状況</h2>
    <div class="data-status-grid">
      <div class="data-status-card">
        <strong>{whiskies.length}</strong>
        <span>登録銘柄</span>
      </div>
      <div class="data-status-card">
        <strong>{sourceReady.length}</strong>
        <span>出典確認済みの個別銘柄</span>
      </div>
      <div class="data-status-card">
        <strong>85</strong>
        <span>登録蒸留所</span>
      </div>
    </div>
    <p class="text-secondary text-sm">
      登録数と検索公開数は同じではありません。一次情報または確認済み外部データを紐づけた銘柄から
      個別ページを検索公開し、未確認レコードはデータベース内の比較・探索用として保持します。
    </p>
  </section>

  {sourceReady.length > 0 ? (
    <section class="home-section">
      <h2>出典確認済みの銘柄</h2>
      <p class="text-secondary text-sm">
        メーカー等の一次情報、または確認日時を持つ外部データがレコードに紐づいている銘柄です。
        順位ではなく名前順で掲載しています。
      </p>
      <WhiskyList whiskies={sourceReady.slice(0, 6)} />
      <p class="home-more"><a href="/whiskies/">全銘柄データベースを見る →</a></p>
    </section>
  ) : null}

  <section class="home-section">
    <h2>このサイトで比較するもの</h2>
    <div class="data-principles">
      <article>
        <h3>製品仕様</h3>
        <p>地域、タイプ、熟成年数、アルコール度数、樽など、銘柄を識別するための項目を整理します。</p>
      </article>
      <article>
        <h3>出典</h3>
        <p>メーカー・公的機関などの一次情報を優先し、外部データを使う場合は確認日時をレコードに残します。</p>
      </article>
      <article>
        <h3>比較</h3>
        <p>独自点数の勝敗ではなく、2〜4本の仕様差を同じ表で確認できる比較ツールを中心にします。</p>
      </article>
    </div>
  </section>

  {latestPosts.length > 0 ? (
    <section class="home-section">
      <h2>解説記事</h2>
      <div class="post-list">
        {latestPosts.map((post) => <PostCard {post} headingLevel={3} />)}
      </div>
      <p class="home-more"><a href="/articles/">記事一覧を見る →</a></p>
    </section>
  ) : null}

  <SourceNote />
</BaseLayout>
