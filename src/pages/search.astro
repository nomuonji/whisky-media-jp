---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import { ja } from '../i18n/ja';

const breadcrumbs = [
  { label: 'ホーム', href: '/' },
  { label: ja.search.title, href: '/search/' },
];
---

<BaseLayout
  title={ja.search.title}
  description="Whisky Data JPの銘柄・蒸留所・記事をキーワードで横断検索できます。"
  noindex={true}
>
  <Breadcrumb items={breadcrumbs} />
  <h1 class="page-title">銘柄・蒸留所・記事を<em>検索</em></h1>

  <form class="search-form" role="search" id="search-form">
    <label class="sr-only" for="search-input">{ja.search.label}</label>
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder="山崎、ピート、アイラ、コスパ…"
      autocomplete="off"
    />
    <button type="submit" class="btn btn-primary">検索</button>
  </form>

  <p class="search-status text-secondary" id="search-status">{ja.search.prompt}</p>
  <ul class="search-results" id="search-results"></ul>
</BaseLayout>

<script>
  interface Item {
    kind: 'whisky' | 'distillery' | 'post';
    kindLabel: string;
    title: string;
    url: string;
    excerpt: string;
    meta: string;
    keywords: string[];
  }

  const form = document.getElementById('search-form') as HTMLFormElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');

  if (form && input && status && results) {
    let index: Item[] | null = null;

    async function loadIndex(): Promise<Item[]> {
      if (!index) {
        const res = await fetch('/search-index.json');
        if (!res.ok) throw new Error(`索引の取得に失敗しました（${res.status}）`);
        index = (await res.json()) as Item[];
      }
      return index;
    }

    // 全角英数を半角にして空白を落とす（フィールド照合用。「ｱｲﾗ」「山崎12年」を吸収）
    function normalize(value: string): string {
      return value
        .replace(/[Ａ-Ｚａ-ｚ０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
        .replace(/[\s　]/g, '')
        .toLowerCase();
    }

    // クエリをトークン化：全角英数を半角→小文字にした後、空白（全半角・連続）で分割。空白削除より先に行う。
    function tokenize(query: string): string[] {
      const pre = query
        .replace(/[Ａ-Ｚａ-ｚ０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
        .toLowerCase();
      return pre.split(/[\s　]+/).filter(Boolean);
    }

    function score(item: Item, terms: string[]): number {
      const title = normalize(item.title);
      const body = normalize(`${item.excerpt}${item.meta}${item.keywords.join('')}`);
      let total = 0;
      for (const term of terms) {
        if (title.includes(term)) total += 3;
        else if (body.includes(term)) total += 1;
        else return 0; // 全語を含むものだけをヒットとする
      }
      // 同点なら銘柄を上に出す（読者が探しているのはたいてい銘柄）
      if (item.kind === 'whisky') total += 0.5;
      return total;
    }

    // 検索結果はDOMで組む。HTML文字列に href を埋めると、
    // テンプレート式がHTMLの属性値としてそのまま配信される。
    function render(matches: Item[], query: string): void {
      results!.replaceChildren(
        ...matches.map((item) => {
          const li = document.createElement('li');
          li.className = `search-item kind-${item.kind}`;

          const kind = document.createElement('span');
          kind.className = 'search-kind';
          kind.textContent = item.kindLabel;

          const link = document.createElement('a');
          link.className = 'search-title';
          link.href = item.url;
          link.textContent = item.title;

          const meta = document.createElement('span');
          meta.className = 'search-meta';
          meta.textContent = item.meta;

          li.append(kind, link, meta);

          if (item.excerpt) {
            const excerpt = document.createElement('p');
            excerpt.className = 'search-excerpt';
            excerpt.textContent = item.excerpt;
            li.append(excerpt);
          }

          return li;
        })
      );

      status!.textContent = matches.length
        ? `${matches.length}件が見つかりました`
        : `「${query}」に一致するものは見つかりませんでした。`;
    }

    async function search(query: string): Promise<void> {
      const terms = tokenize(query);
      if (terms.length === 0) {
        results!.innerHTML = '';
        status!.textContent = 'キーワードを入力すると銘柄・蒸留所・記事をまとめて検索します。';
        return;
      }

      // 索引の取得には時間がかかることがある。無反応に見せない
      if (!index) status!.textContent = '検索中…';

      let items: Item[];
      try {
        items = await loadIndex();
      } catch (error) {
        results!.innerHTML = '';
        status!.textContent =
          '検索できませんでした。通信状況を確認して、ページを再読み込みしてください。';
        return;
      }
      const matches = items
        .map((item) => ({ item, s: score(item, terms) }))
        .filter(({ s }) => s > 0)
        .sort((a, b) => b.s - a.s)
        .map(({ item }) => item);

      render(matches, query.trim());
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const q = input.value.trim();
      history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : location.pathname);
      void search(input.value);
    });

    let timer: number;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => void search(input.value), 200);
    });

    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      void search(initial);
    }
  }
</script>
