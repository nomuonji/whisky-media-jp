---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import WhiskyCard from '../../components/whisky/WhiskyCard.astro';
import SourceNote from '../../components/whisky/SourceNote.astro';
import DiscoveryNav from '../../components/whisky/DiscoveryNav.astro';
import { REGIONS, REGION_LABELS, WHISKY_TYPES, TYPE_LABELS } from '../../types/taxonomy';
import { getWhiskies } from '../../utils/whisky';
import { isIndexReadyWhisky } from '../../utils/trust';

const whiskies = (await getWhiskies()).sort((a, b) => a.data.name.localeCompare(b.data.name, 'ja'));
const usedRegions = REGIONS.filter((r) => whiskies.some((w) => w.data.region === r));
const usedTypes = WHISKY_TYPES.filter((t) => whiskies.some((w) => w.data.type === t));
const sourceReadyCount = whiskies.filter(isIndexReadyWhisky).length;

const regionSet = new Set<string>(REGIONS);
const typeSet = new Set<string>(WHISKY_TYPES);
const initialRegions = Astro.url.searchParams.getAll('region').filter((value) => regionSet.has(value));
const initialTypes = Astro.url.searchParams.getAll('type').filter((value) => typeSet.has(value));
const initialSourceReady = Astro.url.searchParams.getAll('source').includes('ready');
const sortParam = Astro.url.searchParams.get('sort');
const initialSort = sortParam === 'age' || sortParam === 'abv' ? sortParam : 'name';
const hasInitialFilter = initialRegions.length > 0 || initialTypes.length > 0 || initialSourceReady || initialSort !== 'name';

const matchesInitial = (whisky: (typeof whiskies)[number]) => {
  const matchesRegion = initialRegions.length === 0 || initialRegions.includes(whisky.data.region);
  const matchesType = initialTypes.length === 0 || initialTypes.includes(whisky.data.type);
  const matchesSource = !initialSourceReady || isIndexReadyWhisky(whisky);
  return matchesRegion && matchesType && matchesSource;
};

const initialVisible = whiskies.filter(matchesInitial);
const initialCount = initialVisible.length;
const filterSummary = [
  initialRegions.length ? `地域: ${initialRegions.map((region) => REGION_LABELS[region as (typeof REGIONS)[number]]).join('・')}` : '',
  initialTypes.length ? `タイプ: ${initialTypes.map((type) => TYPE_LABELS[type as (typeof WHISKY_TYPES)[number]]).join('・')}` : '',
  initialSourceReady ? '出典確認済みのみ' : '',
].filter(Boolean).join(' / ');

const breadcrumbs = [
  { label: 'ホーム', href: '/' },
  { label: '銘柄データベース', href: '/whiskies/' },
];
---

<BaseLayout
  title="ウイスキー銘柄一覧・データベース"
  description={`ウイスキー${whiskies.length}銘柄を地域・タイプ・出典状態で絞り込めるデータベース。熟成年数・度数・樽などを確認し、比較ツールへ進めます。`}
  {breadcrumbs}
  width="wide"
>
  <Breadcrumb items={breadcrumbs} />

  <h1 class="page-title">ウイスキー<em>銘柄データベース</em></h1>
  <p class="page-lead">
    現在<strong>{whiskies.length}銘柄</strong>を掲載。地域・タイプで絞り込み、
    出典確認済みの<strong>{sourceReadyCount}銘柄</strong>だけに限定することもできます。
  </p>

  <aside class="source-note">
    <p>
      <strong>登録済み = 検索公開済みではありません。</strong>
      一次情報または確認日時を持つ外部データが紐づいた銘柄だけ個別ページを検索公開しています。
      出典整備前のレコードも比較・探索のためデータベース内には残しています。
    </p>
  </aside>

  {hasInitialFilter && (
    <p class="filter-share" id="filter-share">
      リンクの条件: {filterSummary || '並び替えのみ'}。JavaScript無効時も同じ条件で一覧を絞っています。
      出典確認済みは一次情報または確認日時のある外部データがある銘柄だけです。未確認銘柄はおすすめとして扱いません。
      <a href="/compare/">仕様比較ツールへ進む</a>
    </p>
  )}

  <form class="filter-panel" id="filter-panel">
    <fieldset>
      <legend>地域</legend>
      <div class="filter-chips">
        {usedRegions.map((r) => (
          <label class="filter-chip">
            <input type="checkbox" name="region" value={r} checked={initialRegions.includes(r)} />
            <span>{REGION_LABELS[r]}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>タイプ</legend>
      <div class="filter-chips">
        {usedTypes.map((t) => (
          <label class="filter-chip">
            <input type="checkbox" name="type" value={t} checked={initialTypes.includes(t)} />
            <span>{TYPE_LABELS[t]}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>出典状態</legend>
      <div class="filter-chips">
        <label class="filter-chip">
          <input type="checkbox" name="source" value="ready" checked={initialSourceReady} />
          <span>出典確認済みのみ</span>
        </label>
      </div>
    </fieldset>

    <div class="filter-actions">
      <label class="filter-sort">
        並び替え
        <select name="sort" id="sort-select">
          <option value="name" selected={initialSort === 'name'}>名前順</option>
          <option value="age" selected={initialSort === 'age'}>熟成年数が長い順</option>
          <option value="abv" selected={initialSort === 'abv'}>度数が高い順</option>
        </select>
      </label>
      <button type="reset" class="btn btn-secondary btn-sm">条件をリセット</button>
      <a class="btn btn-secondary btn-sm" href="/compare/">比較ツールへ</a>
    </div>
  </form>

  <p class="filter-count" id="filter-count" aria-live="polite">{initialCount}銘柄</p>

  <p class="filter-empty" id="filter-empty" hidden={initialCount > 0}>
    条件に合う銘柄がありません。出典確認済みに限定している場合、未検証レコードは候補から外しています。
    <button type="button" class="btn btn-secondary btn-sm" id="filter-empty-reset">条件をリセット</button>
    <a href="/compare/">比較ツールを開く</a>
  </p>

  <div class="whisky-list" id="whisky-list">
    {whiskies.map((whisky) => (
      <div
        class="whisky-filter-item"
        data-region={whisky.data.region}
        data-type={whisky.data.type}
        data-source={isIndexReadyWhisky(whisky) ? 'ready' : 'catalog'}
        data-age={whisky.data.age ?? 0}
        data-abv={whisky.data.abv}
        data-name={whisky.data.name}
        hidden={!matchesInitial(whisky)}
      >
        <WhiskyCard {whisky} />
      </div>
    ))}
  </div>

  <DiscoveryNav />
  <SourceNote />
</BaseLayout>

<script>
  const panel = document.getElementById('filter-panel') as HTMLFormElement | null;
  const list = document.getElementById('whisky-list');
  const count = document.getElementById('filter-count');
  const empty = document.getElementById('filter-empty');
  const emptyReset = document.getElementById('filter-empty-reset');
  const share = document.getElementById('filter-share');

  if (panel && list && count && empty && emptyReset) {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.whisky-filter-item'));

    const checkedValues = (name: string): string[] =>
      Array.from(panel.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((el) => el.value);

    function syncUrl(regions: string[], types: string[], sourceReadyOnly: boolean, sort: string): void {
      const params = new URLSearchParams();
      regions.forEach((region) => params.append('region', region));
      types.forEach((type) => params.append('type', type));
      if (sourceReadyOnly) params.append('source', 'ready');
      if (sort !== 'name') params.set('sort', sort);
      const next = params.toString();
      const url = next ? `${window.location.pathname}?${next}` : window.location.pathname;
      window.history.replaceState(null, '', url);
      if (share) share.hidden = !next;
    }

    function render(): void {
      const regions = checkedValues('region');
      const types = checkedValues('type');
      const sourceReadyOnly = checkedValues('source').includes('ready');

      const visible = items.filter((el) => {
        const matchesRegion = regions.length === 0 || regions.includes(el.dataset.region ?? '');
        const matchesType = types.length === 0 || types.includes(el.dataset.type ?? '');
        const matchesSource = !sourceReadyOnly || el.dataset.source === 'ready';
        const show = matchesRegion && matchesType && matchesSource;
        el.hidden = !show;
        return show;
      });

      const sort = (panel.querySelector('#sort-select') as HTMLSelectElement | null)?.value ?? 'name';
      visible.sort((a, b) => {
        if (sort === 'age') return Number(b.dataset.age) - Number(a.dataset.age);
        if (sort === 'abv') return Number(b.dataset.abv) - Number(a.dataset.abv);
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'ja');
      });
      visible.forEach((el) => list!.appendChild(el));

      count!.textContent = `${visible.length}銘柄`;
      empty!.hidden = visible.length > 0;
      syncUrl(regions, types, sourceReadyOnly, sort);
    }

    panel.addEventListener('change', render);
    panel.addEventListener('reset', () => window.setTimeout(render, 0));
    emptyReset.addEventListener('click', () => {
      panel.reset();
      render();
    });
    render();
  }
</script>
