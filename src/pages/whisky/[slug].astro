---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import BottleMark from '../../components/whisky/BottleMark.astro';
import SpecTable from '../../components/whisky/SpecTable.astro';
import SourceNote from '../../components/whisky/SourceNote.astro';
import WhiskyCard from '../../components/whisky/WhiskyCard.astro';
import PostCard from '../../components/blog/PostCard.astro';
import AffiliateSection from '../../components/affiliate/AffiliateSection.astro';
import { REGION_LABELS, TYPE_LABELS } from '../../types/taxonomy';
import { getWhiskies, ageLabel } from '../../utils/whisky';
import { getPublishedPosts } from '../../utils/posts';
import { getWhiskyPhoto } from '../../utils/photos';
import { isIndexReadyWhisky, hasSourcedPrice, sourceStatusLabel } from '../../utils/trust';

export async function getStaticPaths() {
  const whiskies = await getWhiskies();
  const posts = await getPublishedPosts();

  return whiskies.map((whisky) => {
    const relatedCatalog = whiskies
      .filter((other) =>
        other.id !== whisky.id &&
        other.data.region === whisky.data.region && other.data.type === whisky.data.type
      )
      .sort((a, b) => a.data.name.localeCompare(b.data.name, 'ja'))
      .slice(0, 4);

    return {
      params: { slug: whisky.id },
      props: {
        whisky,
        relatedCatalog,
        relatedPosts: posts.filter((p) =>
          `${p.data.title}${p.data.excerpt ?? ''}${p.body}`.includes(whisky.data.name)
        ).slice(0, 3),
      },
    };
  });
}

const { whisky, relatedCatalog, relatedPosts } = Astro.props;
const w = whisky.data;
const photo = getWhiskyPhoto(whisky.id);
const indexReady = isIndexReadyWhisky(whisky);
const sourcedPrice = hasSourcedPrice(whisky);
const priceHeading = w.priceSource === 'official' && w.priceBasis ? w.priceBasis : '確認済み価格';

const description =
  `${w.name}（${w.distillery}・${REGION_LABELS[w.region]}／${TYPE_LABELS[w.type]}・${ageLabel(w.age)}・${w.abv}%）の仕様データ。` +
  `${indexReady ? '確認済みソースへのリンク付き。' : 'カタログ登録情報として掲載し、出典整備中。'}`;

const ogImage = `/ogp/whisky-${whisky.id}.png`;

const breadcrumbs = [
  { label: 'ホーム', href: '/' },
  { label: '銘柄一覧', href: '/whiskies/' },
  { label: w.name, href: `/whisky/${whisky.id}/` },
];
---

<BaseLayout title={w.name} {description} {ogImage} {breadcrumbs} noindex={!indexReady}>
  <Breadcrumb items={breadcrumbs} />

  <article class={`whisky-detail region-${w.region}`}>
    <header class="whisky-hero">
      {photo ? (
        <figure class="whisky-hero-photo">
          <img
            src={photo.image}
            alt={`${w.name}のボトル写真`}
            width={photo.thumbWidth ?? photo.width}
            height="auto"
            loading="eager"
          />
          <figcaption>
            写真: {photo.artist}
            <a href={photo.sourceUrl} rel="nofollow">Wikimedia Commons</a>
            （{photo.license}）
          </figcaption>
        </figure>
      ) : (
        <div class="whisky-hero-mark">
          <BottleMark region={w.region} rating={0} size={80} />
        </div>
      )}

      <div class="whisky-hero-body">
        <p class="whisky-hero-tags">
          <a class="badge badge-region" href={`/region/${w.region}/`}>{REGION_LABELS[w.region]}</a>
          <span class="badge badge-neutral">{TYPE_LABELS[w.type]}</span>
          <span class="badge badge-neutral">{ageLabel(w.age)}</span>
          <span class="badge badge-neutral">{w.abv}%</span>
        </p>
        <h1>{w.name}</h1>
        <p class="whisky-hero-en">{w.nameEn}</p>
        <p class="whisky-hero-notes">
          <strong>{sourceStatusLabel(whisky)}。</strong>
          {indexReady
            ? '基本仕様の参照元を下の表から確認できます。'
            : 'このレコードはデータベース探索用に保持しています。一次情報の確認後に検索公開します。'}
        </p>
      </div>

      <dl class="whisky-hero-figures">
        <div>
          <dt>アルコール度数</dt>
          <dd><strong>{w.abv}</strong><span class="unit">%</span></dd>
        </div>
        <div>
          <dt>熟成年数</dt>
          <dd><strong>{ageLabel(w.age)}</strong></dd>
        </div>
        {sourcedPrice ? (
          <div>
            <dt>{priceHeading}</dt>
            <dd><strong>{w.priceYen?.toLocaleString('ja-JP')}円</strong></dd>
          </div>
        ) : null}
      </dl>
    </header>

    <section class="whisky-section">
      <h2>基本データ</h2>
      <SpecTable {whisky} />
      <SourceNote priceAsOf={sourcedPrice ? w.priceAsOf : undefined} priceSource={sourcedPrice ? w.priceSource : undefined} priceBasis={w.priceBasis} />
    </section>

    <AffiliateSection ids={w.affiliateId ? [w.affiliateId] : []} productName={w.name} />

    {relatedCatalog.length > 0 ? (
      <section class="whisky-section">
        <h2>同じ地域・タイプから探す</h2>
        <p class="text-secondary text-sm">好みの推定ではなく、地域または製品タイプが共通する登録銘柄です。</p>
        <div class="whisky-list">
          {relatedCatalog.map((item) => <WhiskyCard whisky={item} />)}
        </div>
      </section>
    ) : null}

    {relatedPosts.length > 0 ? (
      <section class="whisky-section">
        <h2>この銘柄を扱った記事</h2>
        <div class="post-list">
          {relatedPosts.map((post) => <PostCard {post} headingLevel={3} />)}
        </div>
      </section>
    ) : null}
  </article>

  <p class="text-center back-link">
    <a href="/whiskies/">← 銘柄一覧に戻る</a>
  </p>
</BaseLayout>
